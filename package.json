{
  "name": "pocketledger-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "hooks:install": "node scripts/install-gitleaks.mjs && lefthook install",
    "hooks:check": "lefthook run pre-commit",
    "check:backend": "node scripts/checks.mjs backend",
    "check:frontend": "node scripts/checks.mjs frontend",
    "check:hygiene": "node scripts/checks.mjs hygiene",
    "test": "node --test scripts/*.test.mjs",
    "build:keycloak-theme": "npm --prefix src/PocketLedger.Web run build && node scripts/build-keycloak-theme.mjs",
    "build:keycloak-provider": "docker build --output type=local,dest=.artifacts/keycloak-provider infra/keycloak/provider"
  },
  "devDependencies": {
    "lefthook": "2.2.2"
  }
}
