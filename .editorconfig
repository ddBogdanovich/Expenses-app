root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
tab_width = 4

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Interface names use the standard I prefix.
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_interfaces_with_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_style.prefix_interfaces_with_i.required_prefix = I
dotnet_naming_style.prefix_interfaces_with_i.capitalization = pascal_case

# Sonar S4261 checks Task-returning methods for the Async suffix.
dotnet_diagnostic.S4261.severity = warning

[*.{csproj,props,targets,xml,json,yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{ts,tsx,js,jsx,mjs,css,html}]
indent_style = space
indent_size = 2
tab_width = 2
